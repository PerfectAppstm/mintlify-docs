  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode"
    ],
    "display": "toc"
  },
  "metadata": {
    "timestamp": true
  },
  "styling": {
    "latex": true,
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "logo": {
    "light": "/images/EyeSize_P_mask.png",
    "dark": "/images/EyeWidth_mask.png",
    "href": "https://www.image2url.com/r2/default/images/1788003900680-f37499b7-cce8-4075-b850-b1f2712942c6.png"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#8d8d8d",
      "dark": "#0c0c0c"
    },
    "image": {
      "light": "/images/EyeSize_P_mask.png",
      "dark": "/images/EyeOuterCorner_mask.png"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Roboto",
      "weight": 400
    }
  },
  "banner": {
    "content": "Close-Loop << { #System // #Run } >>",
    "dismissible": true,
    "type": "warning",
    "color": {
      "light": "#a3a615",
      "dark": "#b37c0a"
    }
  },
  "thumbnails": {
    "fonts": {
      "family": "Inter"
    },
    "background": "/images/1787565318234-artwork.webp"
  },
  "interaction": {
    "drilldown": true
  },
  "markdown": {
    "schema": true
  },
  "search": {
    "prompt": "2AM™ Search ..."
  },
  "api": {
    "params": {
      "expanded": "all",
      "post": [
        "killswitch"
      ]
    },
    "playground": {
      "display": "auth",
      "credentials": true
    },
    "examples": {
      "defaults": "all",
      "languages": [
        "html",
        "javascript",
        "CSS"
      ],
      "prefill": true,
      "autogenerate": true
    },
    "url": "full"
  },
  "description": "2AM Database++ is the migration and scripting toolkit for teams that ship database changes without downtime, drama, or drift.",
  "seo": {
    "metatags": {
      "functional": "99"
    },
    "indexing": "navigable"
  },
  "variables": {
    "non-variable": "99"
  }
}
