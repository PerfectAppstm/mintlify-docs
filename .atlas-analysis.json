  "keyFeatures": [
    "Pure SQL migrations — no ORM or DSL, just plain .sql files",
    "Multi-environment support — dev, staging, and production from one project",
    "Dynamic replacements — inject environment-specific values at runtime",
    "Flexible credential management — .env files, AWS Secrets Manager, or direct",
    "Scripts support — run ad-hoc SQL for maintenance and data backfills",
    "Multi-project tracking — isolate migrations per service on a shared database",
    "CI/CD ready — headless CLI for automated deployments",
    "Desktop GUI for macOS, Windows, and Linux"
  ],
  "publicApiSurface": [
    "2am-smt init",
    "2am-smt connection:test <environment>",
    "2am-smt migrate:new <migrationName>",
    "2am-smt migrate:to <env> [migrationName]",
    "2am-smt status <env>",
    "2am-smt script:new <scriptName>",
    "2am-smt script:run <env> <scriptName>",
    "npm run migrate <env>",
    "configuration.yml"
  ]
